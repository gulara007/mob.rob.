from pybricks.hubs import EV3Brick
from pybricks.ev3devices import Motor, ColorSensor
from pybricks.parameters import Port, Button
from pybricks.robotics import DriveBase
from pybricks.tools import wait, StopWatch

ev3 = EV3Brick()
left_motor = Motor(Port.B)
right_motor = Motor(Port.C)
sensor = ColorSensor(Port.S4) # Направлен вниз, ~4 мм над полом

robot = DriveBase(left_motor, right_motor, wheel_diameter=56, axle_track=114)

BASE_SPEED = 100 
KP = 1.0         
KD = 1.5         
SLOWDOWN = 0.4   
MAX_TURN = 90    
EDGE = -1      

LOST_THRESHOLD = 45  
CORNER_ERR = 40       
SCAN_SPEED = 60      
SCAN_TIME_MS = 500    

def sample_on_button(message):
    ev3.screen.clear()
    ev3.screen.print(message)
    ev3.screen.print("then press CENTRE")
    while Button.CENTER not in ev3.buttons.pressed():
        wait(10)
    total = 0
    for _ in range(20):
        total += sensor.reflection()
        wait(5)
    while Button.CENTER in ev3.buttons.pressed():
        wait(10)
    return total / 20

def is_line_found(target, span):
    current_err = abs((sensor.reflection() - target) / span * 100)
    return current_err < (LOST_THRESHOLD - 10)

def sweep_and_check(turn_speed, duration_ms, target, span):
    timer = StopWatch()
    robot.drive(0, turn_speed) # Вращение на месте БЕЗ движения вперед
    
    while timer.time() < duration_ms:
        if is_line_found(target, span):
            robot.stop() # Мгновенная остановка при обнаружении края
            return True
        wait(10)
        
    robot.stop()
    return False

def scan_for_line(target, span):
    robot.stop() # Гасим инерцию вперед
    ev3.speaker.beep(frequency=1000, duration=50)

    if sweep_and_check(-SCAN_SPEED, SCAN_TIME_MS, target, span):
        return True

    if sweep_and_check(SCAN_SPEED, SCAN_TIME_MS * 2, target, span):
        return True

    sweep_and_check(-SCAN_SPEED, SCAN_TIME_MS, target, span)
    return False

tape = sample_on_button("Sensor on TAPE")
floor = sample_on_button("Sensor on FLOOR")
target = (tape + floor) / 2 
span = abs(floor - tape) or 1 

ev3.screen.clear()
ev3.screen.print("tape {:.0f}".format(tape))
ev3.screen.print("floor {:.0f}".format(floor))
ev3.screen.print("Place on edge,")
ev3.screen.print("press CENTRE")

while Button.CENTER not in ev3.buttons.pressed():
    wait(10)
while Button.CENTER in ev3.buttons.pressed():
    wait(10)

timer = StopWatch()
last_error = 0

while Button.CENTER not in ev3.buttons.pressed():
    error = (sensor.reflection() - target) / span * 100

    if error > CORNER_ERR:
        robot.drive(BASE_SPEED * 0.4, 100)
        wait(100)
        error = (sensor.reflection() - target) / span * 100
        
        if abs(error) > LOST_THRESHOLD:
            found = scan_for_line(target, span)
            if not found:
                ev3.screen.clear()
                ev3.screen.print("LINE LOST!")
                break
            else:
                last_error = 0
                continue

    derivative = error - last_error
    last_error = error

    turn = EDGE * (KP * error + KD * derivative)
    turn = max(-MAX_TURN, min(MAX_TURN, turn))

    speed = BASE_SPEED * (1 - SLOWDOWN * min(abs(error), 50) / 50)
    robot.drive(speed, turn)
    wait(25) # ~40 Гц 
robot.stop()
ev3.screen.clear()
ev3.screen.print("Time: {:.2f} s".format(timer.time() / 1000))
wait(5000)
