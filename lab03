from pybricks.hubs import EV3Brick
from pybricks.ev3devices import Motor, ColorSensor
from pybricks.parameters import Port, Button
from pybricks.robotics import DriveBase
from pybricks.tools import wait, StopWatch

ev3 = EV3Brick()
left_motor = Motor(Port.B)
right_motor = Motor(Port.C)
sensor = ColorSensor(Port.S4) # Направлен вниз, ~4 мм над полом

robot = DriveBase(left_motor, right_motor, wheel_diameter=56, axle_track=114)

# ---------- Настройки (Tuning knobs) ----------
BASE_SPEED = 100 # мм/с на прямых
KP = 1.0         # Пропорциональный коэффициент
KD = 1.5         # Дифференциальный коэффициент
SLOWDOWN = 0.4   # Замедление на изгибах
MAX_TURN = 90    # Ограничение скорости поворота (град/с)
EDGE = -1        # 1 = следовать одному краю, -1 = другому

# Параметры обработки углов и поиска
LOST_THRESHOLD = 45   # Порог нормализованной ошибки для фиксации потери линии
CORNER_ERR = 40       # Порог ошибки, при котором фиксируется резкий правый поворот
SCAN_SPEED = 60       # Скорость вращения при поиске (град/с)
SCAN_TIME_MS = 500    # Время поворота при сканировании (мс)
# -----------------------------------------------

def sample_on_button(message):
    """Калибровка: показывает сообщение, ждет центральную кнопку и возвращает усредненное значение."""
    ev3.screen.clear()
    ev3.screen.print(message)
    ev3.screen.print("then press CENTRE")
    while Button.CENTER not in ev3.buttons.pressed():
        wait(10)
    total = 0
    for _ in range(20):
        total += sensor.reflection()
        wait(5)
    while Button.CENTER in ev3.buttons.pressed():
        wait(10)
    return total / 20

def is_line_found(target, span):
    """Проверяет, вернулся ли датчик к краю линии."""
    current_err = abs((sensor.reflection() - target) / span * 100)
    return current_err < (LOST_THRESHOLD - 10)

def sweep_and_check(turn_speed, duration_ms, target, span):
    """Поворачивает робота на месте и опрашивает датчик каждые 10 мс."""
    timer = StopWatch()
    robot.drive(0, turn_speed) # Вращение на месте БЕЗ движения вперед
    
    while timer.time() < duration_ms:
        if is_line_found(target, span):
            robot.stop() # Мгновенная остановка при обнаружении края
            return True
        wait(10)
        
    robot.stop()
    return False

def scan_for_line(target, span):
    """Сканирует сначала одну сторону, затем другую при полной потере трассы."""
    robot.stop() # Гасим инерцию вперед
    ev3.speaker.beep(frequency=1000, duration=50)

    # 1. Сканируем влево
    if sweep_and_check(-SCAN_SPEED, SCAN_TIME_MS, target, span):
        return True

    # 2. Сканируем вправо (на двойной угол)
    if sweep_and_check(SCAN_SPEED, SCAN_TIME_MS * 2, target, span):
        return True

    # 3. Если не нашли — возвращаемся в центр
    sweep_and_check(-SCAN_SPEED, SCAN_TIME_MS, target, span)
    return False

# ---------- Двухточечная калибровка ----------
tape = sample_on_button("Sensor on TAPE")
floor = sample_on_button("Sensor on FLOOR")
target = (tape + floor) / 2 # Край = половина ленты + половина пола
span = abs(floor - tape) or 1 # Защита от деления на ноль

ev3.screen.clear()
ev3.screen.print("tape {:.0f}".format(tape))
ev3.screen.print("floor {:.0f}".format(floor))
ev3.screen.print("Place on edge,")
ev3.screen.print("press CENTRE")

while Button.CENTER not in ev3.buttons.pressed():
    wait(10)
while Button.CENTER in ev3.buttons.pressed():
    wait(10)

# ---------- Главный цикл ----------
timer = StopWatch()
last_error = 0

while Button.CENTER not in ev3.buttons.pressed(): # Нажмите CENTRE для остановки
    # Нормализованная ошибка в диапазоне ~ -50..+50
    error = (sensor.reflection() - target) / span * 100

    # ОБРАБОТКА РЕЗКОГО ПОВОРОТА НАПРАВО (90 градусов):
    # Если датчик резко улетел на белый пол, подворачиваем НАПРАВО, а не налево!
    if error > CORNER_ERR:
        robot.drive(BASE_SPEED * 0.4, 100) # Движение с быстрым доворотом вправо
        wait(100)
        # Пересчитываем ошибку после доворота
        error = (sensor.reflection() - target) / span * 100
        
        # Если после доворота линия всё еще не найдена — запускаем сканирование
        if abs(error) > LOST_THRESHOLD:
            found = scan_for_line(target, span)
            if not found:
                ev3.screen.clear()
                ev3.screen.print("LINE LOST!")
                break
            else:
                last_error = 0
                continue

    derivative = error - last_error
    last_error = error

    turn = EDGE * (KP * error + KD * derivative)
    turn = max(-MAX_TURN, min(MAX_TURN, turn)) # Ограничиваем резкость поворота

    # Замедление на крутых изгибах
    speed = BASE_SPEED * (1 - SLOWDOWN * min(abs(error), 50) / 50)
    robot.drive(speed, turn)
    wait(25) # ~40 Гц — частота обновления датчика

robot.stop()
ev3.screen.clear()
ev3.screen.print("Time: {:.2f} s".format(timer.time() / 1000))
wait(5000)
