#include <BLEDevice.h>
#include <BLEScan.h>
#include <BLEAdvertisedDevice.h>

#define UART_RX_PIN 18
#define UART_TX_PIN 17
#define UART_BAUD   115200

#define COMPANY_ID  0xFFFF

// Everyone in the lab may use 0xFFFF! Put board A's MAC here
// (board A prints it in Serial Monitor at start-up). "" = no MAC filter.
#define NODE_MAC    "90:70:69:35:31:fd"   // board A MAC

#if ESP_ARDUINO_VERSION_MAJOR >= 3
typedef String BleStr;
#else
typedef std::string BleStr;
#endif

BLEScan *scan;
volatile bool haveLast = false;
volatile uint16_t lastSeq = 0;

void sendFrame(HardwareSerial &s, const uint8_t *p, uint8_t len) {
  uint8_t chk = len;
  s.write(0xAA);
  s.write(len);
  for (uint8_t i = 0; i < len; i++) { s.write(p[i]); chk ^= p[i]; }
  s.write(chk);
}

class ScanCB : public BLEAdvertisedDeviceCallbacks {
  void onResult(BLEAdvertisedDevice d) override {
    if (!d.haveManufacturerData()) return;

    if (strlen(NODE_MAC) > 0 &&
        strcasecmp(d.getAddress().toString().c_str(), NODE_MAC) != 0) return;

    BleStr md = d.getManufacturerData();
    if (md.length() < 6) return;
    const uint8_t *p = (const uint8_t *)md.c_str();

    uint16_t cid = p[0] | (p[1] << 8);
    if (cid != COMPANY_ID) return;

    uint16_t seq = p[2] | (p[3] << 8);
    if (haveLast && seq == lastSeq) return;   // same reading again -> skip
    lastSeq = seq; haveLast = true;

    int8_t rssi = (int8_t)d.getRSSI();
    uint8_t out[5] = { p[2], p[3], p[4], p[5], (uint8_t)rssi };
    sendFrame(Serial1, out, 5);

    Serial.printf("got seq=%u rssi=%d\n", seq, rssi);
  }
};

void setup() {
  Serial.begin(115200);
  Serial1.begin(UART_BAUD, SERIAL_8N1, UART_RX_PIN, UART_TX_PIN);

  BLEDevice::init("");
  scan = BLEDevice::getScan();
  scan->setAdvertisedDeviceCallbacks(new ScanCB(), true); // true = report duplicates
  scan->setActiveScan(false);   // passive: just listen
  scan->setInterval(100);       // ms
  scan->setWindow(100);         // window == interval -> listening 100 % of the time
  scan->start(0, nullptr, false); // 0 = scan forever, non-blocking
}

void loop() {
  delay(10000);
  scan->clearResults();         // free memory from devices around the room
}
